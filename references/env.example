# Copy to a local shell env if desired (never commit real secrets).
# cache-ui and scripts/snapshot.py honor REDIS_URL.

# Local development (default when unset)
REDIS_URL=redis://127.0.0.1:6379/0

# Centralized production instance (example shapes):
# REDIS_URL=rediss://:YOUR_TOKEN@redis.example.com:6379/0
# REDIS_URL=redis://:YOUR_TOKEN@redis.example.com:6379/0

# Cache State Engine SPA bind (local only by default)
# HOST=127.0.0.1
# PORT=8787
# KEY_SCAN_LIMIT=200
